# Packages installed into the live ISO root (the installer environment).
# Init: dinit only.
base
base-devel
dinit
elogind-dinit
dbus-dinit
dbus-dinit-user
linux
linux-firmware
# Networking tools the installer drives:
networkmanager
networkmanager-dinit
wireless_tools
wpa_supplicant
# Disk / filesystem utilities the installer shells out to:
gptfdisk
dosfstools
e2fsprogs
util-linux
parted
# Disk-wipe methods (manual editor → header wipe strip): hdparm = ATA Secure
# Erase, nvme-cli = `nvme format` for NVMe. blkdiscard/wipefs/shred come from
# util-linux/coreutils already.
hdparm
nvme-cli
# Drive-wear (TBW) screen reads SMART via `smartctl`.
smartmontools
# Bootstrap + chroot helpers:
artools-pkg
arch-install-scripts
# The installer binary is added via the overlay (see profile.conf).
nano
# Console font for the live TTY (the installer runs on a Linux VT, which needs
# a PSF font; Terminus renders the TUI glyphs crisply).
terminus-font
# kbd provides setfont/loadkeys used to apply the console font.
kbd
